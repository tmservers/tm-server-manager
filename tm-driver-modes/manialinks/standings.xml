<manialink name="Driver_Standings" version="3">
<!--
	Style: the classes below set fonts, text and backgrounds. The C_Style constants
	at the top of the script set the colors that change with the standings.
	Colors are hex, opacities go from 0 to 1.
-->
<stylesheet>
	<style class="title" textfont="GameFontBlack" textprefix="$i$t" textcolor="ffffff" textsize="2"/>
	<style class="info" textfont="GameFontSemiBold" textprefix="$i" textcolor="ffffffaa" textsize="1"/>
	<style class="name" textfont="GameFontSemiBold" textprefix="$i" textcolor="ffffff" textsize="1.3"/>
	<style class="number" textfont="OswaldMono" textcolor="ffffff" textsize="1.5"/>
	<style class="round-points" textfont="OswaldMono" textcolor="ffffff" textsize="1.1"/>
	<style class="status" textfont="GameFontBlack" textprefix="$i$t" textcolor="ffffff" textsize="0.7"/>
	<style class="header" bgcolor="000000" opacity="0.85"/>
	<style class="accent" bgcolor="009b5f" opacity="1"/>
	<style class="row" bgcolor="000000" opacity="0.5"/>
	<style class="cell" bgcolor="000000" opacity="0.8"/>
	<style class="highlight" bgcolor="ffffff" opacity="0.8"/>
	<style class="state" bgcolor="ffffff" opacity="0.9"/>
</stylesheet>

<framemodel id="Model_Row">
	<quad class="cell" size="6 4.5"/>
	<label id="Label_Rank" class="number" pos="3 -2.25" size="5.5 4" halign="center" valign="center2"/>
	<quad class="row" pos="6.5 0" size="33 4.5"/>
	<quad id="Quad_Highlight" class="highlight" pos="6.5 0" z-index="1" size="33 4.5" hidden="1"/>
	<label id="Label_Name" class="name" pos="8 -2.25" z-index="2" size="24 4" valign="center2"/>
	<label id="Label_RoundPoints" class="round-points" pos="39 -2.25" z-index="2" size="7 4" halign="right" valign="center2"/>
	<quad class="cell" pos="40 0" size="12 4.5"/>
	<quad id="Quad_State" class="state" pos="40 0" z-index="1" size="12 4.5" hidden="1"/>
	<label id="Label_Points" class="number" pos="51 -2.25" z-index="2" size="11 4" halign="right" valign="center2"/>
	<label id="Label_Status" class="status" pos="46 -2.25" z-index="2" size="11.5 4" halign="center" valign="center2" hidden="1"/>
</framemodel>

<frame id="Frame_Standings" pos="-158 62" hidden="1">
	<quad class="header" size="52 6"/>
	<label id="Label_Title" class="title" pos="2 -3" size="30 5" valign="center2"/>
	<label id="Label_Info" class="info" pos="50.5 -3" size="20 5" halign="right" valign="center2"/>
	<quad class="accent" pos="0 -6" size="52 0.4"/>
	<frameinstance modelid="Model_Row" id="Row_0" pos="0 -6.9"/>
	<frameinstance modelid="Model_Row" id="Row_1" pos="0 -11.9"/>
	<frameinstance modelid="Model_Row" id="Row_2" pos="0 -16.9"/>
	<frameinstance modelid="Model_Row" id="Row_3" pos="0 -21.9"/>
	<frameinstance modelid="Model_Row" id="Row_4" pos="0 -26.9"/>
	<frameinstance modelid="Model_Row" id="Row_5" pos="0 -31.9"/>
	<frameinstance modelid="Model_Row" id="Row_6" pos="0 -36.9"/>
	<frameinstance modelid="Model_Row" id="Row_7" pos="0 -41.9"/>
	<frameinstance modelid="Model_Row" id="Row_8" pos="0 -46.9"/>
	<frameinstance modelid="Model_Row" id="Row_9" pos="0 -51.9"/>
</frame>

<script><!--
/**
 *	Shows the standings the driver host publishes through Net_Driver_Standings.
 *	Every driver mode shares them, so this works with every mode.
 *	The json is tm_server_types::method::DriverStandings.
 */
#Include "TextLib" as TL
#Include "ColorLib" as CL

// Style: colors as hex, applied with every update.
#Const C_Style_OwnColor "1e5f99"
#Const C_Style_GainedColor "66ff99"
#Const C_Style_LostColor "ff6666"
#Const C_Style_PositiveColor "c99a06"
#Const C_Style_NegativeColor "d61919"
#Const C_Style_NeutralColor "5a6470"
#Const C_Style_EliminatedColor "6e1414"
#Const C_Style_SpectatorColor "2e9e23"
#Const C_Style_EliminatedText "Eliminated"
#Const C_Style_SpectatorText "Spectator"

#Const C_MaxRows 10

#Struct K_Standing {
	Text account_id;
	Text name;
	Integer rank;
	Text status;
	Text label;
	Text label_tone;
	Integer points;
	Integer map_points;
	Integer round_points;
}

#Struct K_Standings {
	Text title;
	Text info;
	Integer rounds_on_map;
	Integer maps_played;
	Text map_name;
	Integer map_count;
	K_Standing[] players;
}

Void SetText(CMlFrame _Frame, Text _ControlId, Text _Value) {
	declare CMlLabel Label <=> (_Frame.GetFirstChild(_ControlId) as CMlLabel);
	if (Label != Null) Label.Value = _Value;
}

Void SetTextColor(CMlFrame _Frame, Text _ControlId, Text _Color) {
	declare CMlLabel Label <=> (_Frame.GetFirstChild(_ControlId) as CMlLabel);
	if (Label != Null) Label.TextColor = CL::Hex6ToRgb(_Color);
}

Void SetVisible(CMlFrame _Frame, Text _ControlId, Boolean _Visible) {
	declare CMlControl Control <=> _Frame.GetFirstChild(_ControlId);
	if (Control != Null) Control.Visible = _Visible;
}

/// Shows a quad in a color or hides it for an empty color.
Void SetQuadColor(CMlFrame _Frame, Text _ControlId, Text _Color) {
	declare CMlQuad Quad <=> (_Frame.GetFirstChild(_ControlId) as CMlQuad);
	if (Quad == Null) return;
	Quad.Visible = _Color != "";
	if (_Color != "") Quad.BgColor = CL::Hex6ToRgb(_Color);
}

/// Shown instead of the points like in the original modes: the label of the mode, e.g.
/// Last Chance, or the status. Empty for players who are still playing without a label.
Text StatusText(Text _Status, Text _Label) {
	if (_Label != "") return _Label;
	switch (_Status) {
		case "eliminated": return C_Style_EliminatedText;
		case "spectator": return C_Style_SpectatorText;
	}
	return "";
}

Text StatusColor(Text _Status, Text _Label, Text _LabelTone) {
	if (_Label != "") {
		switch (_LabelTone) {
			case "positive": return C_Style_PositiveColor;
			case "negative": return C_Style_NegativeColor;
		}
		return C_Style_NeutralColor;
	}
	switch (_Status) {
		case "eliminated": return C_Style_EliminatedColor;
		case "spectator": return C_Style_SpectatorColor;
	}
	return "";
}

Void Update(Text _Standings) {
	declare CMlFrame Frame_Standings <=> (Page.GetFirstChild("Frame_Standings") as CMlFrame);
	declare K_Standings Standings;
	if (_Standings == "" || !Standings.fromjson(_Standings)) {
		Frame_Standings.Visible = False;
		return;
	}

	Frame_Standings.Visible = True;
	SetText(Frame_Standings, "Label_Title", Standings.title);
	SetText(Frame_Standings, "Label_Info", Standings.info);

	declare Text Me = "";
	if (LocalUser != Null) Me = LocalUser.WebServicesUserId;

	// The players are ordered by rank, spectators last and left out here. The local
	// player always gets a row, the last one if needed.
	declare Integer[] Shown;
	declare Integer Own = -1;
	foreach (Index => Standing in Standings.players) {
		if (Standing.status == "spectator") continue;
		if (Shown.count < C_MaxRows) Shown.add(Index);
		if (Standing.account_id == Me) Own = Index;
	}
	if (Own >= 0 && !Shown.exists(Own) && Shown.count == C_MaxRows) Shown[C_MaxRows - 1] = Own;

	for (RowIndex, 0, C_MaxRows - 1) {
		declare CMlFrame Row <=> (Page.GetFirstChild("Row_"^RowIndex) as CMlFrame);
		if (Row == Null) continue;
		if (!Shown.existskey(RowIndex)) {
			Row.Visible = False;
			continue;
		}

		declare K_Standing Standing = Standings.players[Shown[RowIndex]];
		Row.Visible = True;
		if (Standing.rank > 0) {
			SetText(Row, "Label_Rank", TL::ToText(Standing.rank));
		} else {
			SetText(Row, "Label_Rank", "-");
		}
		SetText(Row, "Label_Name", Standing.name);
		SetText(Row, "Label_Points", TL::ToText(Standing.points));
		if (Standing.round_points > 0) {
			SetText(Row, "Label_RoundPoints", "+"^TL::ToText(Standing.round_points));
			SetTextColor(Row, "Label_RoundPoints", C_Style_GainedColor);
		} else if (Standing.round_points < 0) {
			SetText(Row, "Label_RoundPoints", TL::ToText(Standing.round_points));
			SetTextColor(Row, "Label_RoundPoints", C_Style_LostColor);
		} else {
			SetText(Row, "Label_RoundPoints", "");
		}

		// A status like Last Chance replaces the points in a colored cell.
		declare Text Status = StatusText(Standing.status, Standing.label);
		SetText(Row, "Label_Status", Status);
		SetVisible(Row, "Label_Status", Status != "");
		SetVisible(Row, "Label_Points", Status == "");
		SetVisible(Row, "Label_RoundPoints", Status == "");
		SetQuadColor(Row, "Quad_State", StatusColor(Standing.status, Standing.label, Standing.label_tone));

		if (Standing.account_id == Me) {
			SetQuadColor(Row, "Quad_Highlight", C_Style_OwnColor);
		} else {
			SetQuadColor(Row, "Quad_Highlight", "");
		}
	}
}

main() {
	declare netread Text Net_Driver_Standings for Teams[0];
	declare netread Integer Net_Driver_StandingsSerial for Teams[0];
	declare Integer LastSerial = -1;

	while (True) {
		yield;
		if (LastSerial == Net_Driver_StandingsSerial) continue;
		LastSerial = Net_Driver_StandingsSerial;
		Update(Net_Driver_Standings);
	}
}
--></script>
</manialink>
