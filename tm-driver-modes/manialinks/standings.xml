<script><!--
/**
 *	Shows the standings a driver mode publishes through Net_Driver_State.
 *	The json is written by tm_driver_sdk::standings::Standings.
 */
#Include "TextLib" as TL

#Const C_MaxRows 10

#Struct K_Standing {
	Text account_id;
	Text name;
	Integer points;
	Integer round_points;
	Text status;
}

#Struct K_Standings {
	Text title;
	Text info;
	K_Standing[] players;
}

Void SetText(CMlFrame _Frame, Text _ControlId, Text _Value) {
	declare CMlLabel Label <=> (_Frame.GetFirstChild(_ControlId) as CMlLabel);
	if (Label != Null) Label.Value = _Value;
}

Void SetTextColor(CMlFrame _Frame, Text _ControlId, Vec3 _Color) {
	declare CMlLabel Label <=> (_Frame.GetFirstChild(_ControlId) as CMlLabel);
	if (Label != Null) Label.TextColor = _Color;
}

Void SetVisible(CMlFrame _Frame, Text _ControlId, Boolean _Visible) {
	declare CMlControl Control <=> _Frame.GetFirstChild(_ControlId);
	if (Control != Null) Control.Visible = _Visible;
}

Void Update(Text _State) {
	declare CMlFrame Frame_Standings <=> (Page.GetFirstChild("Frame_Standings") as CMlFrame);
	declare K_Standings Standings;
	if (_State == "" || !Standings.fromjson(_State)) {
		Frame_Standings.Visible = False;
		return;
	}

	Frame_Standings.Visible = True;
	SetText(Frame_Standings, "Label_Title", Standings.title);
	SetText(Frame_Standings, "Label_Info", Standings.info);

	for (Index, 0, C_MaxRows - 1) {
		declare CMlFrame Row <=> (Page.GetFirstChild("Row_"^Index) as CMlFrame);
		if (Row == Null) continue;
		if (!Standings.players.existskey(Index)) {
			Row.Visible = False;
			continue;
		}

		declare K_Standing Standing = Standings.players[Index];
		Row.Visible = True;
		SetText(Row, "Label_Rank", TL::ToText(Index + 1));
		SetText(Row, "Label_Name", Standing.name);
		SetText(Row, "Label_Points", TL::ToText(Standing.points));
		if (Standing.round_points > 0) {
			SetText(Row, "Label_RoundPoints", "+"^TL::ToText(Standing.round_points));
			SetTextColor(Row, "Label_RoundPoints", <0.4, 1., 0.6>);
		} else if (Standing.round_points < 0) {
			SetText(Row, "Label_RoundPoints", TL::ToText(Standing.round_points));
			SetTextColor(Row, "Label_RoundPoints", <1., 0.4, 0.4>);
		} else {
			SetText(Row, "Label_RoundPoints", "");
		}

		// A status like Eliminated replaces the points.
		declare Boolean HasStatus = Standing.status != "";
		SetText(Row, "Label_Status", Standing.status);
		SetVisible(Row, "Label_Status", HasStatus);
		SetVisible(Row, "Label_Points", !HasStatus);
		SetVisible(Row, "Label_RoundPoints", !HasStatus);
	}
}

main() {
	declare netread Text Net_Driver_State for Teams[0];
	declare netread Integer Net_Driver_StateSerial for Teams[0];
	declare Integer LastSerial = -1;

	while (True) {
		yield;
		if (LastSerial == Net_Driver_StateSerial) continue;
		LastSerial = Net_Driver_StateSerial;
		Update(Net_Driver_State);
	}
}
--></script>
</manialink>
