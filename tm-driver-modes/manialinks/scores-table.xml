<script><!--
/**
 *	The scores table of driver matches, built from the standings the driver host
 *	publishes through Net_Driver_Standings, the players of Net_Driver_Users and the
 *	last round of Net_Driver_Round. The json is
 *	tm_server_types::method::DriverStandings, DriverUsers and DriverRound.
 *
 *	The driver modescript makes this a layer of the type ScoresTable, so the game
 *	shows it like its own scores table: while a player holds the scores table key
 *	and whenever the script forces it, e.g. at the end of a round. The scores table
 *	of the game is hidden meanwhile.
 *
 *	Club tags come from the host, until it knows them from the scores of the connected
 *	players like the logins. Spectators click a player to spectate them.
 */
#Include "TextLib" as TL
#Include "MathLib" as ML
#Include "ColorLib" as CL

// Style: colors as hex, applied while the table is shown.
#Const C_Style_OwnColor "1e5f99"
#Const C_Style_WatchedColor "5a5a5a"
#Const C_Style_HoverOpacity 0.15
#Const C_Style_GainedColor "66ff99"
#Const C_Style_LostColor "ff6666"
#Const C_Style_PositiveColor "c99a06"
#Const C_Style_NegativeColor "d61919"
#Const C_Style_NeutralColor "5a6470"
#Const C_Style_EliminatedColor "6e1414"
#Const C_Style_SpectatorColor "2e9e23"
#Const C_Style_EliminatedText "Eliminated"
#Const C_Style_SpectatorText "Spectator"

#Const C_Rows 100
#Const C_VisibleRows 18
#Const C_RowHeight 5.5

#Struct K_Entry {
	Text account_id;
	Integer position;
	Integer score;
	Integer time;
	Text status;
	Text label;
	Text label_tone;
}

#Struct K_Standings {
	Text title;
	Text info;
	Integer rounds_on_map;
	Integer maps_played;
	Text map_name;
	Integer map_count;
	K_Entry[] entries;
}

#Struct K_Round {
	Integer number;
	K_Entry[] entries;
}

#Struct K_User {
	Text account_id;
	Text name;
	Text club_tag;
	Text zone;
}

#Struct K_Users {
	K_User[] users;
}

/// A connected user, found by their account id.
#Struct K_Connected {
	Text Login;
	Text ClubTag;
}

Void SetText(CMlFrame _Frame, Text _ControlId, Text _Value) {
	declare CMlLabel Label <=> (_Frame.GetFirstChild(_ControlId) as CMlLabel);
	if (Label != Null) Label.Value = _Value;
}

Void SetTextColor(CMlFrame _Frame, Text _ControlId, Text _Color) {
	declare CMlLabel Label <=> (_Frame.GetFirstChild(_ControlId) as CMlLabel);
	if (Label != Null) Label.TextColor = CL::Hex6ToRgb(_Color);
}

Void SetVisible(CMlFrame _Frame, Text _ControlId, Boolean _Visible) {
	declare CMlControl Control <=> _Frame.GetFirstChild(_ControlId);
	if (Control != Null) Control.Visible = _Visible;
}

/// Shows a quad in a color or hides it for an empty color.
Void SetQuadColor(CMlFrame _Frame, Text _ControlId, Text _Color) {
	declare CMlQuad Quad <=> (_Frame.GetFirstChild(_ControlId) as CMlQuad);
	if (Quad == Null) return;
	Quad.Visible = _Color != "";
	if (_Color != "") Quad.BgColor = CL::Hex6ToRgb(_Color);
}

/// The players the host knows by account id.
K_User[Text] KnownUsers(Text _Users) {
	declare K_User[Text] Known;
	declare K_Users Parsed;
	if (_Users == "" || !Parsed.fromjson(_Users)) return Known;
	foreach (Known_User in Parsed.users) {
		Known[Known_User.account_id] = Known_User;
	}
	return Known;
}

/// The name the host knows, the account id until then.
Text PlayerName(K_User[Text] _Known, Text _AccountId) {
	if (_Known.existskey(_AccountId) && _Known[_AccountId].name != "") return _Known[_AccountId].name;
	return _AccountId;
}

/// The points of every player in the last round by account id.
Integer[Text] RoundScores(Text _Round) {
	declare Integer[Text] Result;
	declare K_Round Parsed;
	if (_Round == "" || !Parsed.fromjson(_Round)) return Result;
	foreach (Round_Entry in Parsed.entries) {
		Result[Round_Entry.account_id] = Round_Entry.score;
	}
	return Result;
}

/// Shown instead of the points like in the original modes: the label of the mode, e.g.
/// Last Chance, or the status. Empty for players who are still playing without a label.
Text StatusText(Text _Status, Text _Label) {
	if (_Label != "") return _Label;
	switch (_Status) {
		case "eliminated": return C_Style_EliminatedText;
		case "spectator": return C_Style_SpectatorText;
	}
	return "";
}

Text StatusColor(Text _Status, Text _Label, Text _LabelTone) {
	if (_Label != "") {
		switch (_LabelTone) {
			case "positive": return C_Style_PositiveColor;
			case "negative": return C_Style_NegativeColor;
		}
		return C_Style_NeutralColor;
	}
	switch (_Status) {
		case "eliminated": return C_Style_EliminatedColor;
		case "spectator": return C_Style_SpectatorColor;
	}
	return "";
}

/// The local player watches someone else, e.g. as a spectator or after finishing.
Boolean IsSpectating() {
	return InputPlayer != GUIPlayer;
}

K_Connected[Text] ConnectedUsers() {
	declare K_Connected[Text] Connected;
	foreach (Score in Scores) {
		if (Score.User == Null) continue;
		Connected[Score.User.WebServicesUserId] = K_Connected {
			Login = Score.User.Login,
			ClubTag = Score.User.ClubTag
		};
	}
	return Connected;
}

Void UpdateRow(
	CMlFrame _Row,
	K_Entry _Standing,
	K_User[Text] _Known,
	Integer[Text] _LastRound,
	K_Connected[Text] _Connected,
	Text _Me,
	Text _Watched
) {
	_Row.Visible = True;
	if (_Standing.position > 0) {
		SetText(_Row, "Label_Rank", TL::ToText(_Standing.position));
	} else {
		SetText(_Row, "Label_Rank", "-");
	}

	declare Text Login = "";
	declare Text ClubTag = "";
	if (_Connected.existskey(_Standing.account_id)) {
		Login = _Connected[_Standing.account_id].Login;
		ClubTag = _Connected[_Standing.account_id].ClubTag;
	}
	if (_Known.existskey(_Standing.account_id) && _Known[_Standing.account_id].club_tag != "") {
		ClubTag = _Known[_Standing.account_id].club_tag;
	}
	if (ClubTag != "") {
		SetText(_Row, "Label_ClubTag", "$<"^ClubTag^"$>");
	} else {
		SetText(_Row, "Label_ClubTag", "");
	}
	SetText(_Row, "Label_Name", PlayerName(_Known, _Standing.account_id));

	SetText(_Row, "Label_Points", TL::ToText(_Standing.score));
	declare Integer RoundScore = 0;
	if (_LastRound.existskey(_Standing.account_id)) RoundScore = _LastRound[_Standing.account_id];
	if (RoundScore > 0) {
		SetText(_Row, "Label_RoundPoints", "+"^TL::ToText(RoundScore));
		SetTextColor(_Row, "Label_RoundPoints", C_Style_GainedColor);
	} else if (RoundScore < 0) {
		SetText(_Row, "Label_RoundPoints", TL::ToText(RoundScore));
		SetTextColor(_Row, "Label_RoundPoints", C_Style_LostColor);
	} else {
		SetText(_Row, "Label_RoundPoints", "");
	}

	// A status like Last Chance replaces the points in a colored cell.
	declare Text Status = StatusText(_Standing.status, _Standing.label);
	SetText(_Row, "Label_Status", Status);
	SetVisible(_Row, "Label_Status", Status != "");
	SetVisible(_Row, "Label_Points", Status == "");
	SetQuadColor(_Row, "Quad_State", StatusColor(_Standing.status, _Standing.label, _Standing.label_tone));

	if (_Standing.account_id == _Me) {
		SetQuadColor(_Row, "Quad_Highlight", C_Style_OwnColor);
	} else if (_Standing.account_id == _Watched) {
		SetQuadColor(_Row, "Quad_Highlight", C_Style_WatchedColor);
	} else {
		SetQuadColor(_Row, "Quad_Highlight", "");
	}

	// Only players who still race can be spectated.
	declare CMlQuad Quad_Button <=> (_Row.GetFirstChild("Quad_Button") as CMlQuad);
	if (Quad_Button != Null) {
		declare Text Driver_SpectateLogin for Quad_Button = "";
		if (_Standing.status == "eliminated" || _Standing.status == "spectator") {
			Driver_SpectateLogin = "";
		} else {
			Driver_SpectateLogin = Login;
		}
	}
}

Void Update(Text _Standings, Text _Round, Text _Users, Text _Watched) {
	declare CMlFrame Frame_ScoresTable <=> (Page.GetFirstChild("Frame_ScoresTable") as CMlFrame);
	declare K_Standings Standings;
	if (_Standings == "" || !Standings.fromjson(_Standings)) {
		Frame_ScoresTable.Visible = False;
		return;
	}

	Frame_ScoresTable.Visible = True;
	SetText(Frame_ScoresTable, "Label_Title", Standings.title);
	SetText(Frame_ScoresTable, "Label_Map", Standings.map_name);
	SetText(Frame_ScoresTable, "Label_Info", Standings.info);
	SetVisible(Frame_ScoresTable, "Label_Empty", Standings.entries.count == 0);

	declare Text Me = "";
	if (LocalUser != Null) Me = LocalUser.WebServicesUserId;
	declare K_User[Text] Known = KnownUsers(_Users);
	declare Integer[Text] LastRound = RoundScores(_Round);
	declare K_Connected[Text] Connected = ConnectedUsers();

	// The players are ordered by position, spectators last.
	declare CMlFrame Frame_Rows <=> (Frame_ScoresTable.GetFirstChild("Frame_Rows") as CMlFrame);
	declare Integer Own = -1;
	for (Index, 0, C_Rows - 1) {
		declare CMlFrame Row <=> (Frame_Rows.GetFirstChild("Row_"^Index) as CMlFrame);
		if (Row == Null) continue;
		if (!Standings.entries.existskey(Index)) {
			Row.Visible = False;
			continue;
		}
		UpdateRow(Row, Standings.entries[Index], Known, LastRound, Connected, Me, _Watched);
	}
	foreach (Index => Standing in Standings.entries) {
		if (Standing.account_id == Me) Own = Index;
	}

	declare Integer Rows = ML::Min(Standings.entries.count, C_Rows);
	Frame_Rows.ScrollMax = <0., ML::ToReal(ML::Max(0, Rows - C_VisibleRows)) * C_RowHeight>;

	// The local player keeps a row of their own while the first rows do not show them.
	declare CMlFrame Row_Own <=> (Frame_ScoresTable.GetFirstChild("Row_Own") as CMlFrame);
	if (Own >= C_VisibleRows) {
		UpdateRow(Row_Own, Standings.entries[Own], Known, LastRound, Connected, Me, _Watched);
	} else {
		Row_Own.Visible = False;
	}

	declare Text[] Hints;
	if (Rows > C_VisibleRows) Hints.add("Scroll for more players");
	if (IsSpectating()) Hints.add("Click a player to spectate");
	SetText(Frame_ScoresTable, "Label_Hint", TL::Join(" - ", Hints));
}

main() {
	declare netread Text Net_Driver_Standings for Teams[0];
	declare netread Integer Net_Driver_StandingsSerial for Teams[0];
	declare netread Text Net_Driver_Round for Teams[0];
	declare netread Integer Net_Driver_RoundSerial for Teams[0];
	declare netread Text Net_Driver_Users for Teams[0];
	declare netread Integer Net_Driver_UsersSerial for Teams[0];
	declare Integer LastSerial = -1;
	declare Integer LastRoundSerial = -1;
	declare Integer LastUsersSerial = -1;
	declare Integer LastUserCount = -1;
	declare Text LastWatched = "-";
	declare Boolean LastSpectating = False;

	while (True) {
		yield;

		foreach (Event in PendingEvents) {
			if (Event.ControlId != "Quad_Button") continue;
			declare Text Driver_SpectateLogin for Event.Control = "";
			declare CMlQuad Quad_Button <=> (Event.Control as CMlQuad);
			if (Event.Type == CMlScriptEvent::Type::MouseClick) {
				if (Driver_SpectateLogin != "" && IsSpectating()) {
					ClientUI.Spectator_SetForcedTarget_Clear();
					SetSpectateTarget(Driver_SpectateLogin);
				}
			} else if (Event.Type == CMlScriptEvent::Type::MouseOver) {
				if (Driver_SpectateLogin != "" && IsSpectating()) Quad_Button.Opacity = C_Style_HoverOpacity;
			} else if (Event.Type == CMlScriptEvent::Type::MouseOut) {
				Quad_Button.Opacity = 0.;
			}
		}

		// The spectated player, the connected users and spectating change the table too.
		declare Text Watched = "";
		if (GUIPlayer != Null && GUIPlayer.User != Null) Watched = GUIPlayer.User.WebServicesUserId;
		declare Boolean Spectating = IsSpectating();
		if (
			LastSerial == Net_Driver_StandingsSerial &&
			LastRoundSerial == Net_Driver_RoundSerial &&
			LastUsersSerial == Net_Driver_UsersSerial &&
			LastUserCount == Scores.count &&
			LastWatched == Watched &&
			LastSpectating == Spectating
		) continue;
		LastSerial = Net_Driver_StandingsSerial;
		LastRoundSerial = Net_Driver_RoundSerial;
		LastUsersSerial = Net_Driver_UsersSerial;
		LastUserCount = Scores.count;
		LastWatched = Watched;
		LastSpectating = Spectating;
		Update(Net_Driver_Standings, Net_Driver_Round, Net_Driver_Users, Watched);
	}
}
--></script>
