<script><!--
/**
 *	The scores table of driver matches, built from the standings the driver host
 *	publishes through Net_Driver_Standings. The json is
 *	tm_server_types::method::DriverStandings.
 *
 *	The driver modescript makes this a layer of the type ScoresTable, so the game
 *	shows it like its own scores table: while a player holds the scores table key
 *	and whenever the script forces it, e.g. at the end of a round. The scores table
 *	of the game is hidden meanwhile.
 *
 *	Club tags and logins come from the scores of the connected players. Spectators
 *	click a player to spectate them.
 */
#Include "TextLib" as TL
#Include "MathLib" as ML

#Const C_Rows 100
#Const C_VisibleRows 18
#Const C_RowHeight 5.5

#Struct K_Standing {
	Text account_id;
	Text name;
	Integer rank;
	Text status;
	Integer points;
	Integer map_points;
	Integer round_points;
}

#Struct K_Standings {
	Text title;
	Text info;
	Integer rounds_on_map;
	Integer maps_played;
	K_Standing[] players;
}

/// A connected user, found by their account id.
#Struct K_User {
	Text Login;
	Text ClubTag;
}

Void SetText(CMlFrame _Frame, Text _ControlId, Text _Value) {
	declare CMlLabel Label <=> (_Frame.GetFirstChild(_ControlId) as CMlLabel);
	if (Label != Null) Label.Value = _Value;
}

Void SetTextColor(CMlFrame _Frame, Text _ControlId, Vec3 _Color) {
	declare CMlLabel Label <=> (_Frame.GetFirstChild(_ControlId) as CMlLabel);
	if (Label != Null) Label.TextColor = _Color;
}

Void SetVisible(CMlFrame _Frame, Text _ControlId, Boolean _Visible) {
	declare CMlControl Control <=> _Frame.GetFirstChild(_ControlId);
	if (Control != Null) Control.Visible = _Visible;
}

/// Shown instead of the points like in the original modes, empty for players who are still playing.
Text StatusText(Text _Status) {
	switch (_Status) {
		case "finalist": return "Finalist";
		case "last_chance": return "Last Chance";
		case "eliminated": return "Eliminated";
		case "winner": return "Winner";
		case "spectator": return "Spectator";
	}
	return "";
}

Vec3 StatusColor(Text _Status) {
	switch (_Status) {
		case "finalist": return <1., 0.6, 0.>;
		case "winner": return <1., 0.8, 0.>;
		case "spectator": return <0.28, 0.85, 0.21>;
	}
	return <1., 0., 0.>;
}

/// The local player watches someone else, e.g. as a spectator or after finishing.
Boolean IsSpectating() {
	return InputPlayer != GUIPlayer;
}

K_User[Text] ConnectedUsers() {
	declare K_User[Text] Users;
	foreach (Score in Scores) {
		if (Score.User == Null) continue;
		Users[Score.User.WebServicesUserId] = K_User {
			Login = Score.User.Login,
			ClubTag = Score.User.ClubTag
		};
	}
	return Users;
}

Void UpdateRow(CMlFrame _Row, K_Standing _Standing, K_User[Text] _Users, Text _Me, Text _Watched) {
	_Row.Visible = True;
	if (_Standing.rank > 0) {
		SetText(_Row, "Label_Rank", TL::ToText(_Standing.rank));
	} else {
		SetText(_Row, "Label_Rank", "-");
	}

	declare Text Login = "";
	declare Text ClubTag = "";
	if (_Users.existskey(_Standing.account_id)) {
		Login = _Users[_Standing.account_id].Login;
		ClubTag = _Users[_Standing.account_id].ClubTag;
	}
	if (ClubTag != "") {
		SetText(_Row, "Label_ClubTag", "$<"^ClubTag^"$>");
	} else {
		SetText(_Row, "Label_ClubTag", "");
	}
	SetText(_Row, "Label_Name", _Standing.name);

	SetText(_Row, "Label_Points", TL::ToText(_Standing.points));
	if (_Standing.round_points > 0) {
		SetText(_Row, "Label_RoundPoints", "+"^TL::ToText(_Standing.round_points));
		SetTextColor(_Row, "Label_RoundPoints", <0.4, 1., 0.6>);
	} else if (_Standing.round_points < 0) {
		SetText(_Row, "Label_RoundPoints", TL::ToText(_Standing.round_points));
		SetTextColor(_Row, "Label_RoundPoints", <1., 0.4, 0.4>);
	} else {
		SetText(_Row, "Label_RoundPoints", "");
	}

	// A status like Last Chance replaces the points.
	declare Text Status = StatusText(_Standing.status);
	declare Boolean HasStatus = Status != "";
	SetText(_Row, "Label_Status", Status);
	SetTextColor(_Row, "Label_Status", StatusColor(_Standing.status));
	SetVisible(_Row, "Label_Status", HasStatus);
	SetVisible(_Row, "Label_Points", !HasStatus);

	declare CMlQuad Quad_Background <=> (_Row.GetFirstChild("Quad_Background") as CMlQuad);
	if (Quad_Background != Null) {
		if (_Standing.account_id == _Me) {
			Quad_Background.BgColor = <0.1, 0.35, 0.6>;
		} else if (_Standing.account_id == _Watched) {
			Quad_Background.BgColor = <0.35, 0.35, 0.35>;
		} else {
			Quad_Background.BgColor = <0., 0., 0.>;
		}
	}

	// Only players who still race can be spectated.
	declare CMlQuad Quad_Button <=> (_Row.GetFirstChild("Quad_Button") as CMlQuad);
	if (Quad_Button != Null) {
		declare Text Driver_SpectateLogin for Quad_Button = "";
		if (_Standing.status == "eliminated" || _Standing.status == "spectator") {
			Driver_SpectateLogin = "";
		} else {
			Driver_SpectateLogin = Login;
		}
	}
}

Void Update(Text _Standings, Text _Watched) {
	declare CMlFrame Frame_ScoresTable <=> (Page.GetFirstChild("Frame_ScoresTable") as CMlFrame);
	declare K_Standings Standings;
	if (_Standings == "" || !Standings.fromjson(_Standings)) {
		Frame_ScoresTable.Visible = False;
		return;
	}

	Frame_ScoresTable.Visible = True;
	SetText(Frame_ScoresTable, "Label_Title", Standings.title);
	SetText(Frame_ScoresTable, "Label_Info", Standings.info);
	SetVisible(Frame_ScoresTable, "Label_Empty", Standings.players.count == 0);

	declare Text Me = "";
	if (LocalUser != Null) Me = LocalUser.WebServicesUserId;
	declare K_User[Text] Users = ConnectedUsers();

	// The players are ordered by rank, spectators last.
	declare CMlFrame Frame_Rows <=> (Frame_ScoresTable.GetFirstChild("Frame_Rows") as CMlFrame);
	declare Integer Own = -1;
	for (Index, 0, C_Rows - 1) {
		declare CMlFrame Row <=> (Frame_Rows.GetFirstChild("Row_"^Index) as CMlFrame);
		if (Row == Null) continue;
		if (!Standings.players.existskey(Index)) {
			Row.Visible = False;
			continue;
		}
		UpdateRow(Row, Standings.players[Index], Users, Me, _Watched);
	}
	foreach (Index => Standing in Standings.players) {
		if (Standing.account_id == Me) Own = Index;
	}

	declare Integer Rows = ML::Min(Standings.players.count, C_Rows);
	Frame_Rows.ScrollMax = <0., ML::ToReal(ML::Max(0, Rows - C_VisibleRows)) * C_RowHeight>;

	// The local player keeps a row of their own while the first rows do not show them.
	declare CMlFrame Row_Own <=> (Frame_ScoresTable.GetFirstChild("Row_Own") as CMlFrame);
	if (Own >= C_VisibleRows) {
		UpdateRow(Row_Own, Standings.players[Own], Users, Me, _Watched);
	} else {
		Row_Own.Visible = False;
	}

	declare Text[] Hints;
	if (Rows > C_VisibleRows) Hints.add("Scroll for more players");
	if (IsSpectating()) Hints.add("Click a player to spectate");
	SetText(Frame_ScoresTable, "Label_Hint", TL::Join(" - ", Hints));
}

main() {
	declare netread Text Net_Driver_Standings for Teams[0];
	declare netread Integer Net_Driver_StandingsSerial for Teams[0];
	declare Integer LastSerial = -1;
	declare Integer LastUserCount = -1;
	declare Text LastWatched = "-";
	declare Boolean LastSpectating = False;

	while (True) {
		yield;

		foreach (Event in PendingEvents) {
			if (Event.ControlId != "Quad_Button") continue;
			declare Text Driver_SpectateLogin for Event.Control = "";
			declare CMlQuad Quad_Button <=> (Event.Control as CMlQuad);
			if (Event.Type == CMlScriptEvent::Type::MouseClick) {
				if (Driver_SpectateLogin != "" && IsSpectating()) {
					ClientUI.Spectator_SetForcedTarget_Clear();
					SetSpectateTarget(Driver_SpectateLogin);
				}
			} else if (Event.Type == CMlScriptEvent::Type::MouseOver) {
				if (Driver_SpectateLogin != "" && IsSpectating()) Quad_Button.Opacity = 0.15;
			} else if (Event.Type == CMlScriptEvent::Type::MouseOut) {
				Quad_Button.Opacity = 0.;
			}
		}

		// The spectated player, the connected users and spectating change the table too.
		declare Text Watched = "";
		if (GUIPlayer != Null && GUIPlayer.User != Null) Watched = GUIPlayer.User.WebServicesUserId;
		declare Boolean Spectating = IsSpectating();
		if (
			LastSerial == Net_Driver_StandingsSerial &&
			LastUserCount == Scores.count &&
			LastWatched == Watched &&
			LastSpectating == Spectating
		) continue;
		LastSerial = Net_Driver_StandingsSerial;
		LastUserCount = Scores.count;
		LastWatched = Watched;
		LastSpectating = Spectating;
		Update(Net_Driver_Standings, Watched);
	}
}
--></script>
</manialink>
