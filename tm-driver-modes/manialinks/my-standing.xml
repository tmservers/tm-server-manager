<manialink name="Driver_MyStanding" version="3">
<!--
	Style: the classes below set fonts, text and backgrounds. The C_Style constants
	at the top of the script set the colors that change with the standings.
	Colors are hex, opacities go from 0 to 1.
-->
<stylesheet>
	<style class="rank" textfont="GameFontBlack" textprefix="$i" textcolor="ffffff" textsize="4.5"/>
	<style class="score" textfont="OswaldMono" textcolor="ffffff" textsize="2.5"/>
	<style class="status" textfont="GameFontBlack" textprefix="$i$t" textcolor="ffffff" textsize="1.5"/>
	<style class="detail" textfont="GameFontSemiBold" textprefix="$i" textcolor="ffffffaa" textsize="1"/>
	<style class="accent" bgcolor="009b5f" opacity="1"/>
	<style class="cell" bgcolor="000000" opacity="0.85"/>
	<style class="row" bgcolor="000000" opacity="0.55"/>
	<style class="state" bgcolor="ffffff" opacity="0.9"/>
</stylesheet>

<frame id="Frame_MyStanding" pos="104 -62" hidden="1">
	<quad class="accent" size="54 0.5"/>
	<quad class="cell" pos="0 -0.5" size="18 11.5"/>
	<label id="Label_Rank" class="rank" pos="9 -6.25" size="17 10" halign="center" valign="center2"/>
	<quad class="row" pos="18.5 -0.5" size="35.5 11.5"/>
	<quad id="Quad_State" class="state" pos="18.5 -0.5" z-index="1" size="35.5 7" hidden="1"/>
	<label id="Label_Score" class="score" pos="52 -4" z-index="2" size="32 5" halign="right" valign="center2"/>
	<label id="Label_Status" class="status" pos="36.25 -4" z-index="2" size="33 5" halign="center" valign="center2" hidden="1"/>
	<label id="Label_Detail" class="detail" pos="52 -9.5" z-index="2" size="32 4" halign="right" valign="center2"/>
</frame>

<script><!--
/**
 *	Shows where the local player stands, from the standings the driver host
 *	publishes through Net_Driver_Standings. Works with every driver mode.
 *	The json is tm_server_types::method::DriverStandings.
 */
#Include "TextLib" as TL
#Include "ColorLib" as CL

// Style: colors as hex, applied with every update.
#Const C_Style_GainedColor "66ff99"
#Const C_Style_LostColor "ff6666"
#Const C_Style_DetailColor "ffffff"
#Const C_Style_FinalistColor "e08a00"
#Const C_Style_LastChanceColor "d61919"
#Const C_Style_EliminatedColor "6e1414"
#Const C_Style_WinnerColor "c99a06"
#Const C_Style_SpectatorColor "2e9e23"
#Const C_Style_FinalistText "Finalist"
#Const C_Style_LastChanceText "Last Chance"
#Const C_Style_EliminatedText "Eliminated"
#Const C_Style_WinnerText "Winner"
#Const C_Style_SpectatorText "Spectator"
#Const C_Style_PointsSuffix " pts"

#Struct K_Standing {
	Text account_id;
	Text name;
	Integer rank;
	Text status;
	Integer points;
	Integer map_points;
	Integer round_points;
}

#Struct K_Standings {
	Text title;
	Text info;
	Integer rounds_on_map;
	Integer maps_played;
	Text map_name;
	Integer map_count;
	K_Standing[] players;
}

Void SetText(Text _ControlId, Text _Value) {
	declare CMlLabel Label <=> (Page.GetFirstChild(_ControlId) as CMlLabel);
	if (Label != Null) Label.Value = _Value;
}

Void SetTextColor(Text _ControlId, Text _Color) {
	declare CMlLabel Label <=> (Page.GetFirstChild(_ControlId) as CMlLabel);
	if (Label != Null) Label.TextColor = CL::Hex6ToRgb(_Color);
}

Void SetVisible(Text _ControlId, Boolean _Visible) {
	declare CMlControl Control <=> Page.GetFirstChild(_ControlId);
	if (Control != Null) Control.Visible = _Visible;
}

/// Shows a quad in a color or hides it for an empty color.
Void SetQuadColor(Text _ControlId, Text _Color) {
	declare CMlQuad Quad <=> (Page.GetFirstChild(_ControlId) as CMlQuad);
	if (Quad == Null) return;
	Quad.Visible = _Color != "";
	if (_Color != "") Quad.BgColor = CL::Hex6ToRgb(_Color);
}

/// Shown instead of the points like in the original modes, empty for players who are still playing.
Text StatusText(Text _Status) {
	switch (_Status) {
		case "finalist": return C_Style_FinalistText;
		case "last_chance": return C_Style_LastChanceText;
		case "eliminated": return C_Style_EliminatedText;
		case "winner": return C_Style_WinnerText;
		case "spectator": return C_Style_SpectatorText;
	}
	return "";
}

Text StatusColor(Text _Status) {
	switch (_Status) {
		case "finalist": return C_Style_FinalistColor;
		case "last_chance": return C_Style_LastChanceColor;
		case "eliminated": return C_Style_EliminatedColor;
		case "winner": return C_Style_WinnerColor;
		case "spectator": return C_Style_SpectatorColor;
	}
	return "";
}

/// 1st, 2nd, 3rd, 4th, 11th, 21st, ...
Text Ordinal(Integer _Rank) {
	declare Text Rank = TL::ToText(_Rank);
	if (_Rank % 100 >= 11 && _Rank % 100 <= 13) return Rank^"th";
	switch (_Rank % 10) {
		case 1: return Rank^"st";
		case 2: return Rank^"nd";
		case 3: return Rank^"rd";
	}
	return Rank^"th";
}

Void Update(Text _Standings) {
	declare CMlFrame Frame_MyStanding <=> (Page.GetFirstChild("Frame_MyStanding") as CMlFrame);
	declare K_Standings Standings;
	declare K_Standing Mine;
	declare Boolean Found = False;
	if (LocalUser != Null && _Standings != "" && Standings.fromjson(_Standings)) {
		foreach (Standing in Standings.players) {
			if (Standing.account_id == LocalUser.WebServicesUserId) {
				Mine = Standing;
				Found = True;
			}
		}
	}

	// Players who are not part of the standings see nothing.
	Frame_MyStanding.Visible = Found;
	if (!Found) return;

	if (Mine.rank > 0) {
		SetText("Label_Rank", Ordinal(Mine.rank));
	} else {
		SetText("Label_Rank", "-");
	}

	// A status like Last Chance replaces the points in a colored cell.
	declare Text Status = StatusText(Mine.status);
	SetText("Label_Status", Status);
	SetText("Label_Score", TL::ToText(Mine.points)^C_Style_PointsSuffix);
	SetVisible("Label_Status", Status != "");
	SetVisible("Label_Score", Status == "");
	SetQuadColor("Quad_State", StatusColor(Mine.status));

	if (Mine.round_points > 0) {
		SetText("Label_Detail", "+"^TL::ToText(Mine.round_points)^" last round");
		SetTextColor("Label_Detail", C_Style_GainedColor);
	} else if (Mine.round_points < 0) {
		SetText("Label_Detail", TL::ToText(Mine.round_points)^" last round");
		SetTextColor("Label_Detail", C_Style_LostColor);
	} else {
		SetText("Label_Detail", Standings.info);
		SetTextColor("Label_Detail", C_Style_DetailColor);
	}
}

main() {
	declare netread Text Net_Driver_Standings for Teams[0];
	declare netread Integer Net_Driver_StandingsSerial for Teams[0];
	declare Integer LastSerial = -1;

	while (True) {
		yield;
		if (LastSerial == Net_Driver_StandingsSerial) continue;
		LastSerial = Net_Driver_StandingsSerial;
		Update(Net_Driver_Standings);
	}
}
--></script>
</manialink>
