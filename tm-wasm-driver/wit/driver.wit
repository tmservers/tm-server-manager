package tmservers:driver@0.1.0;

/// Types exchanged between the driver host and a mode.
///
/// Events are built from the standard callbacks of the server. The host
/// handles the transport details of the driver modescript: waiting holds and
/// letting them continue.
interface types {
    /// The races of one player in the current round, from the standard waypoint
    /// callbacks of the server.
    record race-result {
        account-id: string,
        /// The player started a race in this round, so everyone with a time did.
        /// False for spectators and players that could not spawn.
        started: bool,
        /// Checkpoints the player passed in the last race of the round, the finish included.
        progress: u32,
        /// The race times at those checkpoints in milliseconds, so players who got
        /// equally far can be told apart.
        progress-times: list<u32>,
        /// Time of the last finished race of the round in milliseconds. None without a
        /// finish. In single attempt rounds this is the race of the round.
        previous-time: option<u32>,
        previous-checkpoints: list<u32>,
        /// Best race time of the round in milliseconds. None without a finish.
        /// In time attack rounds this is the race that counts.
        best-time: option<u32>,
        best-checkpoints: list<u32>,
    }

    record round-end {
        /// The round should not count: it was forced to end or skipped (e.g. after a
        /// pause), or the host did not see it start, e.g. after the bridge restarted.
        forced: bool,
        /// Every connected player and everyone else who started in the round.
        results: list<race-result>,
    }

    /// Everything a mode gets told about.
    ///
    /// The server waits for the commands of map-start, round-end and map-end
    /// before it continues. match-start, round-start, race-start and match-end are
    /// informative.
    variant event {
        match-start,
        map-start,
        round-start,
        /// The account id of a player who started their first race of the current
        /// round, e.g. so the standings show everyone who plays before the first
        /// round ends.
        race-start(string),
        round-end(round-end),
        map-end,
        match-end,
    }

    /// What the host knows about a player. Read only metadata, a mode asks for it
    /// with `host.find-user`.
    record user {
        account-id: string,
        /// Empty until the host got the name from the server.
        name: string,
        /// Empty while unknown.
        club-tag: string,
        /// E.g. `World|Europe|Germany`. Empty while unknown.
        zone: string,
    }

    /// Whether a player takes part in the match and can still race. Who wins and
    /// loses is told by the position, what a mode calls a state (e.g. last chance)
    /// by the label.
    enum status {
        /// Takes part and can still race.
        playing,
        /// Out of the match. The position the mode gave the player at the elimination is final.
        eliminated,
        /// Takes no part in the match, e.g. joined too late. Not ranked and left out
        /// of round results.
        spectator,
    }

    /// How a label is shown.
    enum tone {
        neutral,
        /// Something good, e.g. a win.
        positive,
        /// Something bad, e.g. being one round from elimination.
        negative,
    }

    /// Shown in place of the points, e.g. `Last Chance` or `Winner`. Only for display,
    /// the host and the manialinks know nothing about its text.
    record label {
        text: string,
        tone: tone,
    }

    /// A player in the standings of the match or of a round.
    record entry {
        account-id: string,
        /// Rank in the match or place in the round, from 1. The modes give every
        /// player their own position. 0 until the mode sets it, e.g. for players who
        /// just joined.
        position: u32,
        /// Points of the match or of the round.
        score: s32,
        /// E.g. the race that counted in the round, in milliseconds.
        time: option<u32>,
        status: status,
        label: option<label>,
    }

    /// The scores of a match in one structure every mode shares.
    ///
    /// The host keeps the standings and hands them to the mode with every event.
    /// What the mode returns is shown to the players and reported to the manager,
    /// so a mode keeps no scores of its own. The host clears what belongs to a new
    /// match or map before the mode gets the event.
    record standings {
        /// The match: one entry for every player taking part. Kept between events.
        entries: list<entry>,
        /// The round that ended with this event, filled by the mode at round-end.
        /// The host takes it out after every event: it shows it as the last round
        /// and reports it to the manager. Ignored for forced rounds.
        round: list<entry>,
        /// Rounds of the current map that counted, as the mode counts them. The host
        /// clears them when a map starts.
        rounds-on-map: u32,
        /// Rounds of the match that were not forced. The host counts the ending round
        /// before round-end.
        rounds-played: u32,
        /// Maps that ended in this match. The host counts the ending map before map-end.
        maps-played: u32,
        /// Progress of the match shown with the standings, e.g. `2 / 5 rounds`.
        info: string,
    }

    /// How long the remaining players have to finish once the first player finished.
    variant finish-timeout {
        /// 5 seconds plus a sixth of the author time.
        automatic,
        /// The round only ends once every player finished or gave up.
        disabled,
        milliseconds(u32),
    }

    /// How rounds are played.
    variant round-format {
        /// One attempt per player. The round ends once nobody is racing anymore or the
        /// finish timeout ran out. Automatic is the default when a match starts.
        single-attempt(finish-timeout),
        /// Players restart as often as they like and their best time counts.
        /// The round ends after this many milliseconds. 0 behaves like a single attempt.
        time-attack(u32),
    }

    /// A warmup with the built-in warmup of the game.
    record warm-up {
        /// Warmup rounds, 0 for none.
        rounds: u32,
        /// How long one warmup round lasts. 0 lets every player drive once.
        duration-ms: u32,
        /// Time to finish after the first player finished in rounds of one try.
        /// None computes it from the author time like the finish timeout.
        timeout-ms: option<u32>,
    }

    record can-spawn {
        account-id: string,
        can-spawn: bool,
    }

    record layer {
        name: string,
        manialink: string,
    }

    variant command {
        /// Applies to the next round that starts. Send it in reply to map-start or round-end.
        set-round-format(round-format),
        /// The warmup before the first round of the map. Send it in reply to map-start,
        /// warmup races are no rounds and never reach the mode.
        set-warm-up(warm-up),
        /// Players that cannot spawn are out of the race (e.g. eliminated).
        /// The host leaves out permissions it already sent in this match.
        set-can-spawn(can-spawn),
        /// Ends the map once the current hold continues.
        end-map,
        /// Ends the match once the current hold continues.
        end-match,
        /// Plays this map of the playlist next, counted from 0. Without it the host
        /// plays the playlist in order and starts every match with its first map.
        set-next-map(u32),
        /// Creates or replaces a manialink layer that is always shown. The scores table
        /// is chosen with the manialinks of the config.
        set-layer(layer),
        remove-layer(string),
        /// Readable by manialinks through `netread Text Net_Driver_State for Teams[0]`.
        /// The host publishes the standings itself, this is for data of a mode the
        /// standings can not hold.
        set-net-state(string),
        /// A message for everyone in the chat.
        chat-message(string),
    }

    /// What a mode returns for an event.
    record decision {
        /// The standings after the event. The host keeps them for the next event.
        standings: standings,
        /// Applied in order.
        commands: list<command>,
    }
}

/// Functions the host provides to modes.
interface host {
    use types.{user};

    enum log-level {
        trace,
        debug,
        info,
        warn,
        error,
    }

    log: func(level: log-level, message: string);
    /// What the host knows about a player, e.g. the name for a chat message.
    find-user: func(account-id: string) -> option<user>;
    /// Maps in the playlist of the match, 0 without one.
    map-count: func() -> u32;
}

/// A game mode controlling the driver modescript.
///
/// Modes run without WASI. Everything they know comes from their settings, the
/// standings and the events, so replaying the events of a match rebuilds exactly
/// the same standings. That is how a mode resumes, there are no snapshots.
world mode {
    use types.{event, standings, decision};

    import host;

    /// Called once with the json settings of the match.
    export init: func(settings: string) -> result<_, string>;
    /// Name of the mode, shown above the standings.
    export name: func() -> string;
    /// Called for every event with the standings the mode returned last.
    export step: func(standings: standings, event: event) -> decision;
}
