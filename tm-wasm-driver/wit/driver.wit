package tmservers:driver@0.1.0;

/// Types exchanged between the driver host and a mode.
///
/// Events are built from the standard callbacks of the server. The host
/// handles the transport details of the driver modescript: waiting holds and
/// letting them continue.
interface types {
    /// The races of one player as reported by the standard scores callback.
    record race-result {
        account-id: string,
        name: string,
        /// The player started a race in this round. False for spectators and players
        /// that could not spawn.
        started: bool,
        /// Checkpoints the player passed in the last race of the round, the finish included.
        progress: u32,
        /// Time of the last race in milliseconds. None if the player did not finish it.
        /// In single attempt rounds this is the race of the round.
        previous-time: option<u32>,
        previous-checkpoints: list<u32>,
        /// Best race time in milliseconds. None if the player did not finish.
        /// In time attack rounds this is the best race of the round.
        best-time: option<u32>,
        best-checkpoints: list<u32>,
    }

    record player {
        account-id: string,
        /// Empty if the host did not get the name from the scores yet.
        name: string,
    }

    record round-end {
        /// The round was forced to end or skipped (e.g. after a pause) and should not count.
        forced: bool,
        /// Every player of the scores and everyone else who started in the round.
        results: list<race-result>,
    }

    /// Everything a mode gets told about.
    ///
    /// The server waits for the commands of map-start, round-end and map-end
    /// before it continues. match-start, round-start, race-start and match-end are
    /// informative.
    variant event {
        match-start,
        map-start,
        round-start,
        /// A player started their first race of the current round, e.g. so the
        /// standings show everyone who plays before the first round ends.
        race-start(player),
        round-end(round-end),
        map-end,
        match-end,
    }

    /// Where a player stands in the match.
    enum status {
        /// Takes part and has neither won nor lost yet.
        playing,
        /// Wins the match by winning a round (cup).
        finalist,
        /// The next bad round eliminates the player (reverse cup).
        last-chance,
        /// Out of the match. The rank the mode gave the player at the elimination is final.
        eliminated,
        /// Won the match.
        winner,
        /// Takes no part in the match, e.g. joined a reverse cup too late. Not ranked.
        spectator,
    }

    record standing {
        account-id: string,
        name: string,
        /// Players with the same rank are tied. 0 until the mode ranks the player.
        rank: u32,
        status: status,
        /// Points of the match.
        points: s32,
        /// Points of the current map. The host clears them when a map starts.
        map-points: s32,
        /// Points of the current round. The host clears them before every round end.
        round-points: s32,
    }

    /// The scores of a match in one structure every mode shares.
    ///
    /// The host keeps the standings and hands them to the mode with every event.
    /// What the mode returns is shown to the players and reported to the manager,
    /// so a mode keeps no scores of its own. The host clears what belongs to a new
    /// match, map or round before the mode gets the event.
    record standings {
        /// Every player taking part in the match.
        players: list<standing>,
        /// Rounds of the current map that counted. The host clears them when a map starts.
        rounds-on-map: u32,
        /// Maps that ended in this match. The host counts the ending map before map-end.
        maps-played: u32,
        /// Progress of the match shown with the standings, e.g. `2 / 5 rounds`.
        info: string,
    }

    /// How long the remaining players have to finish once the first player finished.
    variant finish-timeout {
        /// 5 seconds plus a sixth of the author time.
        automatic,
        /// The round only ends once every player finished or gave up.
        disabled,
        milliseconds(u32),
    }

    /// How rounds are played.
    variant round-format {
        /// One attempt per player. The round ends once nobody is racing anymore or the
        /// finish timeout ran out. Automatic is the default when a match starts.
        single-attempt(finish-timeout),
        /// Players restart as often as they like and their best time counts.
        /// The round ends after this many milliseconds. 0 behaves like a single attempt.
        time-attack(u32),
    }

    record can-spawn {
        account-id: string,
        can-spawn: bool,
    }

    record layer {
        name: string,
        manialink: string,
    }

    variant command {
        /// Applies to the next round that starts. Send it in reply to map-start or round-end.
        set-round-format(round-format),
        /// Players that cannot spawn are out of the race (e.g. eliminated).
        /// The host leaves out permissions it already sent in this match.
        set-can-spawn(can-spawn),
        /// Ends the map once the current hold continues.
        end-map,
        /// Ends the match once the current hold continues.
        end-match,
        /// Creates or replaces a manialink layer that is always shown. The scores table
        /// is chosen with the manialinks of the config.
        set-layer(layer),
        remove-layer(string),
        /// Readable by manialinks through `netread Text Net_Driver_State for Teams[0]`.
        /// The host publishes the standings itself, this is for data of a mode the
        /// standings can not hold.
        set-net-state(string),
        /// A message for everyone in the chat.
        chat-message(string),
    }

    /// What a mode returns for an event.
    record decision {
        /// The standings after the event. The host keeps them for the next event.
        standings: standings,
        /// Applied in order.
        commands: list<command>,
    }
}

/// Functions the host provides to modes.
interface host {
    enum log-level {
        trace,
        debug,
        info,
        warn,
        error,
    }

    log: func(level: log-level, message: string);
}

/// A game mode controlling the driver modescript.
///
/// Modes run without WASI. Everything they know comes from their settings, the
/// standings and the events, so replaying the events of a match rebuilds exactly
/// the same standings. That is how a mode resumes, there are no snapshots.
world mode {
    use types.{event, standings, decision};

    import host;

    /// Called once with the json settings of the match.
    export init: func(settings: string) -> result<_, string>;
    /// Name of the mode, shown above the standings.
    export name: func() -> string;
    /// Called for every event with the standings the mode returned last.
    export step: func(standings: standings, event: event) -> decision;
}
